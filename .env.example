# Copy to .env.local (never committed). Same keys go into Vercel > Project > Settings > Environment Variables.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
# Full service account JSON on one line, or base64 of the file
GOOGLE_SERVICE_ACCOUNT_JSON=
SHEET_ID=
