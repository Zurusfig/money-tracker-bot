# Dashboard (optional): LINE Login channel in the SAME provider as the bot, with a LIFF app
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# Local preview with made-up data (ignored in production): DASH_DEMO=1
